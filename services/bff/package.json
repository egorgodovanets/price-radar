    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.3.0",
    "ioredis": "^5.11.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eddeee888/gcg-typescript-resolver-files": "^0.19.0",
    "@graphql-codegen/cli": "^7.4.3",
