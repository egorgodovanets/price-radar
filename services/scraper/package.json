{
  "name": "@price-radar/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "scrape:once": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/index.js --once",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../../node_modules/jest/bin/jest.js --passWithNoTests"
  },
  "dependencies": {
    "pino": "^10.4.0"
  }
}
